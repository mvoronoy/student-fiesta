@startuml
actor "Кухар" as cook
participant "Холодильник" as fridge
participant "Миска" as bowl
participant "Дошка для нарізання" as board
participant "Сковорідка" as pan
participant "Лаваш" as lavash

== Підготовка інгредієнтів ==
cook -> fridge : Дістати курячі стегна, овочі, сметану
fridge --> cook : Інгредієнти

== Маринування м'яса ==
cook -> board : Нарізати курячі стегна смужками
board --> cook : Нарізане м'ясо
cook -> bowl : Покласти м'ясо, додати спеції,\nчасник, лимонний сік, йогурт
cook -> bowl : Перемішати та накрити

== Приготування соусу ==
cook -> bowl : Змішати сметану, часник, зелень, сіль
bowl --> cook : Часниковий соус

== Підготовка овочів ==
cook -> board : Нарізати помідори, огірки, капусту
board --> cook : Нарізані овочі

== Смаження м'яса ==
cook -> pan : Розігріти сковорідку з олією
activate pan
cook -> pan : Викласти замариноване м'ясо
loop Поки м'ясо не стане золотистим
    cook -> pan : Перемішати м'ясо
    pan --> cook : Стан готовності
end
cook -> pan : Зняти м'ясо з вогню
deactivate pan

== Збирання шаурми ==
cook -> pan : Підігріти лаваш на сухій сковорідці
cook -> lavash : Розкласти лаваш
cook -> lavash : Змастити соусом
cook -> lavash : Викласти м'ясо та овочі
cook -> lavash : Загорнути лаваш
activate lavash

opt Якщо хочеться хрустку скоринку
    cook -> pan : Підсмажити шаурму з двох боків
    pan --> cook : Шаурма з рум'яною скоринкою
end
deactivate lavash

cook -> cook : Подати на стіл

@enduml